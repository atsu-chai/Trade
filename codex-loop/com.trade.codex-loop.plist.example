<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.trade.codex-loop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ooshitaatsushinin/program/trade/codex-loop/run.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/trade-codex-loop.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/trade-codex-loop-error.log</string>
</dict>
</plist>
